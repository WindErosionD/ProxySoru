# 调试脚本：tools/_*.py 常硬编码订阅链接/token，默认不提交
tools/_*.py
tools/_*/
tools/_*.yaml
tools/_*.yml
tools/_*.json
tools/_*.txt

# Ninja 目录：只跟踪说明 / 版本 / 内核；其余为本地安装包、测订阅产物
clients/ninja/*
!clients/ninja/README.md
!clients/ninja/VERSION
!clients/ninja/ninja.exe
!clients/ninja/ninja

# 调试与临时文件（仅仓库根目录，勿误伤 __init__.py）
/_*
/_*.json
/_*.txt
/_*.bin
/_*.log

# 环境检测 / bootstrap 日志（根目录散落时）
/pip_install_last.log
/bootstrap_diag.txt
/last_bootstrap.log
