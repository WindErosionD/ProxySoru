# =============================================================================
# ProxySoru：本地敏感数据与运行时产物（默认不提交）
# =============================================================================

# 用户本地配置（从 ssrspeed_config.example.json 复制后修改；含代理账号、订阅 URL 等）
ssrspeed_config.json
ssrspeed_config.local.json
ssrspeed_config.*.local.json

# Mihomo 测速时自动写入，含节点 UUID / 密码 / plugin-opts / PASS-INFO
config_mihomo.yaml
config_mihomo*.yaml
config.yaml
config.yml
profiles/

# Mihomo / Ninja 运行时缓存（cwd 下自动生成）
cache.db
**/cache.db

# 测速结果 JSON/图片/HTML（含节点名、IP、速度等）
results/

# 运行日志（可能含订阅 URL、节点摘要）
logs/
*.log

